// PanRoute Nextflow configuration
manifest {
    name        = 'PanRoute'
    description = 'Retrosynthetic route search across all KEGG genomes'
    author      = 'Brilliant Genomics Institute'
    version     = '0.1.0'
    mainScript  = 'main.nf'
    nextflowVersion = '>=22.10.0'
}

params {
    outdir = "$projectDir/results"
    cache  = "$projectDir/cache"
}

profiles {

    // Default here: base python already has networkx + equilibrator_api, so no env build.
    standard {
        process.executor = 'local'
    }

    // Portable/reproducible on a fresh machine: build the conda env from the spec.
    conda {
        process.executor = 'local'
        process.conda    = "$projectDir/conf/environment.yml"
        conda.enabled    = true
    }

    slurm {
        process.executor   = 'slurm'
        process.conda      = "$projectDir/conf/environment.yml"
        conda.enabled      = true
        process.cpus       = 2
        process.memory     = '8 GB'
        process.time       = '6h'
        // KEGG fetch stage is I/O bound + rate-limited; keep PANROUTE serial per node
        process {
            withName: PANROUTE { maxForks = 1; cpus = 1 }
        }
    }

    test {
        // fast, deterministic, validation-PASSING smoke test: pin the acetone reaction set
        // (expansion depth must be >= route length; depth 2 is deliberately too shallow and
        //  FAILS validation — a demonstration that the G4 gate catches bad configs).
        params.queries   = "$projectDir/conf/queries_test.csv"
        params.reactions = "$projectDir/conf/acetone_reactions.txt"
        params.no_thermo = true
    }

    docker {
        docker.enabled = true
        process.container = 'panroute:0.1.0'
    }
}

// provenance
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt" }
